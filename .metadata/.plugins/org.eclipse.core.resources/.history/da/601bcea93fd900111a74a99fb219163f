package ProjetoCardapio.controller;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;

@Controller
public class HomeContoller {

    // Exibe a tela de login inicial ao acessar http://localhost:8080/
    @GetMapping("/")
    public String exibirLogin() {
        return "login"; // Vai procurar pelo arquivo login.html na pasta templates
    }

    // Processa os dados que o usuário digitou no formulário
    @PostMapping("/login")
    public String processarLogin(
            @RequestParam("matricula") String matricula,
            @RequestParam("senha") String senha,
            @RequestParam("perfil") String perfil,
            Model model) {

        // Simulação temporária de autenticação 
        if (senha.equals("123")) {
            
            // Redireciona para a página específica conforme o perfil selecionado
            if (perfil.equals("ALUNO")) {
                return "redirect:/aluno/dashboard";
            } else if (perfil.equals("NUTRICIONISTA")) {
                return "redirect:/nutricionista/dashboard";
            } else if (perfil.equals("COZINHEIRA")) {
                return "redirect:/cozinheira/dashboard";
            }
        }

        // Se a senha estiver errada, volta para a tela de login com uma mensagem de erro
        model.addAttribute("erro", "Matrícula ou senha inválidos! (Dica profissional: use a senha 123)");
        return "login";
    }

    // Rotas das telas de destino após o login de cada perfil
    @GetMapping("/aluno/dashboard")
    public String dashboardAluno() { 
        return "dashboard-aluno"; 
    }

    @GetMapping("/nutricionista/dashboard")
    public String dashboardNutricionista() { 
        return "dashboard-nutricionista"; 
    }

    @GetMapping("/cozinheira/dashboard")
    public String dashboardCozinheira() { 
        return "dashboard-cozinheira"; 
    }
}
